@page "/inventory"
@using KbStoreApiClient
@using KbStoreApiClient.Models
@rendermode InteractiveServer
@inject KbStoreApiClient Client

<PageTitle>Inventory Management</PageTitle>

<h1>Stock Items</h1>

<button class="btn btn-primary" @onclick="CreateNew">Create New</button>
<hr />
<h2>Existing Inventory</h2>

@if (_models is null)
{
    <strong>Loading ...</strong>
}
else
{
    @if (_models.Count == 0)
    {

    }
    else
    {
        <table id="inventory">
            <thead>
            <tr>
                <td>Part Number</td>
                <td>Stock Quantity</td>
                <td>Status</td>
                <td>Description</td>
            </tr>
            </thead>
            <tbody>
            @foreach (var model in _models)
            {
                <tr>
                    <td>@model.PartNumber</td>
                    <td>@model.StockQuantity</td>
                    <td>@model.Status</td>
                    <td>@model.Description</td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@code {
    readonly List<InventoryModel>? _models = null;
    readonly List<Task> _tasks = [];

    protected override async Task OnInitializedAsync()
    {
        _tasks.Add(Update());

        await base.OnInitializedAsync()
            .ConfigureAwait(false);
    }

    private void CreateNew()
    {
    }

    private async Task Update()
    {
        var inventoryResponse = await Client.Inventory.GetAsync()
            .ConfigureAwait(false);

        _models.Clear();
        _models.AddRange(inventoryResponse?.Results ?? []);

        _tasks.RemoveAll(t => t.IsCompleted);
    }
}
